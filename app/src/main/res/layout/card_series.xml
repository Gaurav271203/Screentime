<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/cs_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:paddingStart="4dp"
        android:textColor="@color/text_primary"
        android:textSize="38sp" />

    <TextView
        android:id="@+id/cs_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:text="Turn on notification access to count notifications"
        android:textColor="@color/link"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.example.screentime.UsageBarChart
        android:id="@+id/cs_chart"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="14dp" />

    <LinearLayout
        android:id="@+id/cs_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <View
        android:id="@+id/cs_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/grid" />

    <TextView
        android:id="@+id/cs_viewall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="18dp"
        android:text="View all"
        android:textColor="@color/text_primary"
        android:textSize="19sp" />
</LinearLayout>
