<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <include layout="@layout/view_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="26dp"
                android:paddingBottom="18dp"
                android:textColor="@color/text_secondary"
                android:textSize="22sp" />

            <!-- weekday header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <TextView style="@style/WeekdayHead" android:text="M" />
                <TextView style="@style/WeekdayHead" android:text="T" />
                <TextView style="@style/WeekdayHead" android:text="W" />
                <TextView style="@style/WeekdayHead" android:text="T" />
                <TextView style="@style/WeekdayHead" android:text="F" />
                <TextView style="@style/WeekdayHead" android:text="S" />
                <TextView
                    style="@style/WeekdayHead"
                    android:text="S"
                    android:textColor="#FFE5645A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <!-- legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/dot_green"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="Used"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:drawableStart="@drawable/dot_track"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="Remaining"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:drawableStart="@drawable/dot_red"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="Over goal"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grid" />

            <!-- today -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill_dark"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="22dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/tvRemain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/text_primary"
                        android:textSize="36sp" />

                    <TextView
                        android:id="@+id/tvRemainLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp" />
                </LinearLayout>

                <com.example.screentime.RingView
                    android:id="@+id/ring"
                    android:layout_width="150dp"
                    android:layout_height="150dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
